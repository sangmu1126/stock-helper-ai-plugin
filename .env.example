# OpenAI parser integration. Leave empty when using deterministic parser only.
OPENAI_API_KEY=
SAFE_TRADE_RULE_LLM_MODEL=gpt-4.1-mini
SAFE_TRADE_RULE_LLM_TIMEOUT_SECONDS=20

# Prototype/runtime environment.
SAFE_TRADE_ENV=local
SAFE_TRADE_STATE_TABLE=
SAFE_TRADE_DECISION_LOG_TABLE=
SAFE_TRADE_BROKER_SECRET=
SAFE_TRADE_STATE_BACKEND=memory
SAFE_TRADE_DECISION_LOG_BACKEND=memory

# Runtime policy/config hotloading. Defaults keep the packaged local fallback.
SAFE_TRADE_CONFIG_BACKEND=local
SAFE_TRADE_CONFIG_TTL_SECONDS=60
SAFE_TRADE_POLICY_CONFIG_PATH=
SAFE_TRADE_RISK_LIMITS_PATH=
SAFE_TRADE_PROMPT_SECURITY_CONFIG_PATH=
SAFE_TRADE_POLICY_SSM_PARAMETER=
SAFE_TRADE_RISK_SSM_PARAMETER=
SAFE_TRADE_PROMPT_SECURITY_SSM_PARAMETER=
SAFE_TRADE_APPCONFIG_APPLICATION=
SAFE_TRADE_APPCONFIG_ENVIRONMENT=
SAFE_TRADE_APPCONFIG_PROFILE=
SAFE_TRADE_POLICY_APPCONFIG_PROFILE=
SAFE_TRADE_RISK_APPCONFIG_PROFILE=
SAFE_TRADE_PROMPT_SECURITY_APPCONFIG_PROFILE=

# Future KakaoPay Securities integration. Do not commit real values.
KAKAOPAY_API_BASE_URL=
KAKAOPAY_API_KEY=
KAKAOPAY_API_SECRET=
KAKAOPAY_ACCOUNT_ID=
